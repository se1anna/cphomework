# ==============================================================================
# 武汉大学计算物理作业自动批改系统 (CPHomework) - Git 忽略规则配置
# 重点目标：严防各类 API 密钥、JWT 密钥、本地开发机密文件及生产证书泄露
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心机密与环境变量文件 (Security & Credentials - 严防泄露)
# ------------------------------------------------------------------------------
.dev.vars
.dev.vars.*
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# 保留配置示例模板供团队参考
!.dev.vars.example
!.env.example

# 证书、私钥与认证凭据文件
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.json
service-account*.json
client_secret*.json

# ------------------------------------------------------------------------------
# 2. Cloudflare Workers & Wrangler 本地仿真持久化目录
# ------------------------------------------------------------------------------
.wrangler/
.mf/

# ------------------------------------------------------------------------------
# 3. 构建产物与打包缓存 (Build Outputs)
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
*.tsbuildinfo
.eslintcache
.parcel-cache

# ------------------------------------------------------------------------------
# 4. 依赖管理与日志 (Dependencies & Logs)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. 编辑器与操作系统特定文件 (IDEs & OS Artifacts)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# JetBrains (WebStorm, IDEA, etc.)
.idea/
*.iws
*.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Sublime
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 6. 测试覆盖率与临时文件 (Testing & Temp)
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
doc/
tmp/
temp/
scratch/
*.log
